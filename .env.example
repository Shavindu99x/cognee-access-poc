# Copy this file to ".env" (same folder) and fill in ONE of the two options.
# Cognee reads .env automatically from the folder you run the scripts in.

# ---------------------------------------------------------------
# OPTION A — OpenAI (simplest: one key covers LLM + embeddings)
# ---------------------------------------------------------------
LLM_API_KEY="sk-..."
# Optional: pick a cheaper/faster model for the PoC
# LLM_MODEL="openai/gpt-4o-mini"

# ---------------------------------------------------------------
# OPTION B — Azure OpenAI (comment out option A first)
# Use your Azure DEPLOYMENT names, prefixed with "azure/".
# ---------------------------------------------------------------
# LLM_PROVIDER="azure"
# LLM_MODEL="azure/<your-chat-deployment-name>"
# LLM_ENDPOINT="https://<your-resource>.openai.azure.com/"
# LLM_API_KEY="<azure-key>"
# LLM_API_VERSION="2024-10-21"
#
# EMBEDDING_PROVIDER="azure"
# EMBEDDING_MODEL="azure/<your-embedding-deployment-name>"
# EMBEDDING_ENDPOINT="https://<your-resource>.openai.azure.com/"
# EMBEDDING_API_KEY="<azure-key>"
# EMBEDDING_API_VERSION="2024-10-21"
# EMBEDDING_DIMENSIONS=3072      # 3072 for text-embedding-3-large, 1536 for -small

# ---------------------------------------------------------------
# Access control — already forced ON in poc_config.py, listed for clarity
# ---------------------------------------------------------------
ENABLE_BACKEND_ACCESS_CONTROL=true
CACHING=false
